	<queryString>
		<![CDATA[SELECT littera.venda.valor_total,
	littera.venda.data_operacao,
	littera.venda.caixa_data,
	littera.cliente.nome,
	littera.venda.cod_venda,
	littera.item_venda.preco,
	littera.item_venda.quantidade,
	littera.livro.nome AS livro
FROM littera.item_venda
	INNER JOIN littera.venda ON 
	 littera.item_venda.cod_venda = littera.venda.cod_venda 
	INNER JOIN littera.cliente ON 
	 littera.venda.cod_cliente = littera.cliente.cod_cliente 
	INNER JOIN littera.livro ON 
	 littera.item_venda.cod_livro = littera.livro.cod_livro]]>
	</queryString>
