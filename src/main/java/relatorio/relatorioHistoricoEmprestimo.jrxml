	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Littera"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<queryString>
		<![CDATA[SELECT littera.emprestimo.data_devolucao,
	littera.emprestimo.data_locacao,
	littera.emprestimo.valor,
	littera.emprestimo.multa,
	littera.cliente.nome AS cliente,
	littera.livro.nome AS livro,
	littera.item_emprestimo.preco,
	littera.item_emprestimo.multa AS livro_multa,
	littera.item_emprestimo.data_real,
	littera.item_emprestimo.situacao,
	littera.emprestimo.caixa_data,
	littera.emprestimo.cod_emprestimo
FROM littera.item_emprestimo
	INNER JOIN littera.emprestimo ON 
	 littera.item_emprestimo.cod_emprestimo = littera.emprestimo.cod_emprestimo 
	INNER JOIN littera.livro ON 
	 littera.item_emprestimo.cod_livro = littera.livro.cod_livro 
	INNER JOIN littera.cliente ON 
	 littera.emprestimo.cod_cliente = littera.cliente.cod_cliente]]>
	</queryString>
