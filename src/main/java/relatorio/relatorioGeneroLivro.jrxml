	<queryString>
		<![CDATA[SELECT littera.livro.nome,
	littera.livro.autor,
	littera.livro.editora,
	littera.livro.prateleira,
	littera.genero.nome AS genero
FROM littera.livro
	INNER JOIN littera.genero ON 
	 littera.livro.cod_genero = littera.genero.cod_genero]]>
	</queryString>
