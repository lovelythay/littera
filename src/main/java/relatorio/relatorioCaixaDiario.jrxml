	<queryString>
		<![CDATA[SELECT littera.caixa.caixa_data,
	littera.caixa.horario_abertura,
	littera.caixa.horario_fechamento,
	littera.caixa.valor_abertura,
	littera.caixa.total_entrada,
	littera.caixa.total_saida,
	littera.caixa.saldo,
	littera.usuario.nome,
	littera.movimentacao.valor,
	littera.movimentacao.tipo,
	littera.movimentacao.cod_movimentacao,
	littera.movimentacao.motivo
FROM littera.movimentacao
	INNER JOIN littera.caixa ON 
	 littera.movimentacao.caixa_data = littera.caixa.caixa_data 
	INNER JOIN littera.usuario ON 
	 littera.caixa.cod_usuario = littera.usuario.cod_usuario]]>
	</queryString>
