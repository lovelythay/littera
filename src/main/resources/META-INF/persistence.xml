<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">
    <persistence-unit name="LitteraPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>modelo.Genero</class>
        <class>modelo.Cliente</class>
        <class>modelo.Usuario</class>
        <class>modelo.Livro</class>
        <class>modelo.Emprestimo</class>
        <class>modelo.ItemEmprestimo</class>
        <class>modelo.ItemVenda</class>
        <class>modelo.Venda</class>
        <class>modelo.Caixa</class>
        <class>modelo.Movimentacao</class>
        <class>modelo.Historico</class>
        <properties>
            <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect"/>
        </properties>
    </persistence-unit>
</persistence>